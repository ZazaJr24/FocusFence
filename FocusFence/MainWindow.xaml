     <StackPanel Visibility="Collapsed"><TextBlock x:Name="SessionText"/><TextBlock x:Name="BoundsSubtext"/><TextBlock x:Name="PipStatusText"/><TextBlock x:Name="ToggleHint"/></StackPanel>
    </StackPanel>
     <StackPanel x:Name="ProfilesPage" Visibility="Collapsed">
      <TextBlock Text="Spiel hinzufügen" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Wähle ein laufendes Spiel. Oder erfasse es nach einem kurzen Countdown." Style="{StaticResource MutedText}" Margin="0,8,0,15"/>
      <ComboBox x:Name="GameWindows" AutomationProperties.Name="Laufende Spielfenster"/><WrapPanel Margin="0,12,0,0"><Button x:Name="RefreshGamesButton" Content="Fenster laden" Margin="0,0,8,0"/><Button x:Name="AddGameButton" Content="Hinzufügen" Style="{StaticResource Primary}" Margin="0,0,8,0"/><Button x:Name="CaptureGameButton" Content="In 5 s erfassen"/></WrapPanel><TextBlock x:Name="CaptureText" Foreground="#ABD0BA" Margin="0,10,0,0"/>
      <Border Style="{StaticResource Rule}"/>
      <Grid><TextBlock Text="Gespeicherte Profile" FontSize="18" FontWeight="SemiBold"/><Button x:Name="DeleteProfileButton" Content="Löschen" Style="{StaticResource Quiet}" Foreground="#DDA49D" HorizontalAlignment="Right" MinHeight="30" Padding="8,3"/></Grid>
      <TextBlock x:Name="NoProfilesText" Text="Noch keine Profile. Füge oben dein erstes Spiel hinzu." Style="{StaticResource MutedText}" Margin="0,16,0,0"/><ComboBox x:Name="EditProfiles" Margin="0,15,0,22" AutomationProperties.Name="Profil bearbeiten"/>
      <StackPanel x:Name="ProfileEditor"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,22,0"><TextBlock Text="Name" Style="{StaticResource Label}"/><TextBox x:Name="ProfileName" AutomationProperties.Name="Profilname"/><TextBlock Text="Bereich" Style="{StaticResource Label}" Margin="0,20,0,8"/><ComboBox x:Name="AreaChoice" AutomationProperties.Name="Sperrbereich"><ComboBoxItem Content="Spielfenster"/><ComboBoxItem Content="Ganzer Monitor"/></ComboBox><TextBlock Text="Monitor" Style="{StaticResource Label}" Margin="0,20,0,8"/><ComboBox x:Name="MonitorChoice" AutomationProperties.Name="Monitor"/></StackPanel>
      <StackPanel Grid.Column="1"><TextBlock Text="Prozess" Style="{StaticResource Label}"/><TextBox x:Name="ProcessName" IsReadOnly="True" Foreground="#A4A6AF" AutomationProperties.Name="Spielprozess"/><TextBlock x:Name="InsetLabel" Text="Randabstand · 0 px" Style="{StaticResource Label}" Margin="0,20,0,12"/><Slider x:Name="InsetSlider" Minimum="0" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True" Foreground="#B1B5C1" AutomationProperties.Name="Randabstand in Pixel"/><TextBlock Text="Abstand vom Fensterrand, von 0 bis 50 Pixel." Style="{StaticResource MutedText}" FontSize="11" Margin="0,9,0,0"/><CheckBox x:Name="PipEnabled" Content="PiP-Klickschutz" Margin="0,28,0,5"/><TextBlock Text="Für das auf der Übersicht gewählte Videofenster." Style="{StaticResource MutedText}" FontSize="11"/></StackPanel></Grid>
      <WrapPanel Margin="0,26,0,0"><Button x:Name="SaveProfileButton" Style="{StaticResource Primary}" Content="Speichern" Margin="0,0,10,0"/></WrapPanel></StackPanel><WrapPanel Margin="0,15,0,0"><Button x:Name="ExportProfilesButton" Content="Exportieren" Margin="0,0,10,0"/><Button x:Name="ImportProfilesButton" Content="Importieren"/></WrapPanel>
     </StackPanel>
     <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
      <TextBlock Text="Tastenkürzel" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Funktionieren auch im Spiel. Änderungen werden direkt gespeichert." Style="{StaticResource MutedText}" Margin="0,8,0,20"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Text="Schutz an / aus" Style="{StaticResource Label}"/><ComboBox x:Name="ToggleKeyChoice" AutomationProperties.Name="Tastenkürzel Schutz"><ComboBoxItem Content="Strg + Alt + F8" Tag="F8"/><ComboBoxItem Content="Strg + Alt + F6" Tag="F6"/><ComboBoxItem Content="Strg + Alt + F10" Tag="F10"/></ComboBox></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="30 Sekunden Pause" Style="{StaticResource Label}"/><ComboBox x:Name="PauseKeyChoice" AutomationProperties.Name="Tastenkürzel Pause"><ComboBoxItem Content="Strg + Alt + F9" Tag="F9"/><ComboBoxItem Content="Strg + Alt + F7" Tag="F7"/><ComboBoxItem Content="Strg + Alt + F11" Tag="F11"/></ComboBox></StackPanel></Grid>
      <TextBlock Text="Die Notfall-Freigabe ist immer Strg + Alt + F12." Style="{StaticResource MutedText}" FontSize="12" Margin="0,15,0,0"/><TextBlock x:Name="HotkeyStatus" Foreground="#A7CFB4" FontSize="12" Margin="0,9,0,0"/>
      <Border Style="{StaticResource Rule}"/>
      <TextBlock Text="Automatik" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/><CheckBox x:Name="AutoPipSetting" Content="Bild-in-Bild automatisch erkennen"/><CheckBox x:Name="AutoGameSetting" Content="Bekannte Spiele automatisch auswählen"/><TextBlock Text="Neue Videofenster werden auch nach einem Browser-Neustart gefunden." Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0"/><Border Style="{StaticResource Rule}"/><TextBlock Text="Verhalten" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/><CheckBox x:Name="TraySetting" Content="Beim Schließen im Infobereich weiterlaufen"/><CheckBox x:Name="StartupSetting" Content="Mit Windows starten"/><CheckBox x:Name="MinimizedSetting" Content="Beim Start direkt in den Infobereich"/><CheckBox x:Name="SoundSetting" Content="Ton beim Umschalten"/><TextBlock Text="Der Schutz ist nach jedem Programmstart zunächst aus." Style="{StaticResource MutedText}" FontSize="12" Margin="0,9,0,0"/>
      <Border Style="{StaticResource Rule}"/>
      <TextBlock Text="Lokale Daten" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="LifetimeText" Style="{StaticResource MutedText}" Margin="0,10,0,15"/><WrapPanel><Button x:Name="OpenDataButton" Content="Datenordner öffnen" Margin="0,0,10,0"/><Button x:Name="ExitButton" Content="FocusFence beenden"/></WrapPanel>
     </StackPanel>
     <StackPanel x:Name="HelpPage" Visibility="Collapsed">
      <TextBlock Text="Einrichten" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="1. Öffne ein Bild-in-Bild-Video im Browser. FocusFence sucht das Videofenster automatisch.&#x0a;&#x0a;2. Schalte den Schutz ein und wechsle ins Spiel. Bekannte Spiele werden automatisch ausgewählt. Andere Spiele kannst du direkt unter Spiel wählen; ein Profil wird dabei automatisch angelegt.&#x0a;&#x0a;3. Alt+Tab gibt Maus und Video frei. Zurück im Spiel wird der Schutz wieder aktiv.&#x0a;&#x0a;Wenn mehrere Videos offen sind oder ein Fenster nicht erkannt wird, kannst du es unter Bild-in-Bild → Ändern selbst wählen." Style="{StaticResource MutedText}" LineHeight="23" Margin="0,15,0,0"/>
      <Border Style="{StaticResource Rule}"/>
      <TextBlock Text="Freigeben" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Strg + Alt + F9 pausiert für 30 Sekunden. Mit Strg + Alt + F12 schaltest du den Schutz sofort aus. Ein separater Wiederherstellungsprozess gibt die von FocusFence gesetzten Änderungen bei einem unerwarteten Programmende wieder frei." Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
      <Border Style="{StaticResource Rule}"/>
      <TextBlock Text="Hinweise" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Fenster- und randloser Vollbildmodus eignen sich besonders für Bild-in-Bild. Die automatische Erkennung sucht etwa jede Sekunde nach neuen Videofenstern. Bei mehreren Treffern bleibt das bisher gewählte Video erhalten; sonst wählst du eines unter Ändern aus.&#x0a;&#x0a;Manche Browser oder geschützte Spiele erlauben keine fremden Fensteränderungen. Windows kann Zugriffe auf Fenster mit höheren Rechten begrenzen. Fehler erscheinen unten im Status.&#x0a;&#x0a;FocusFence nutzt Windows-Fensterfunktionen und verändert keinen Spielspeicher. Prüfe die Regeln deines Spiels und teste den Schutz vor einer wichtigen Runde." Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
     </StackPanel>

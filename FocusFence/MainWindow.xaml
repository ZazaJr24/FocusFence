              <StackPanel Visibility="Collapsed"><TextBlock x:Name="SessionText"/><TextBlock x:Name="BoundsSubtext"/><TextBlock x:Name="PipStatusText"/><TextBlock x:Name="PauseHint"/></StackPanel>
            </StackPanel>

            <StackPanel x:Name="ProfilesPage" Visibility="Collapsed">
              <TextBlock Text="Add a running game" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="GameWindows" Tag="Select a running window" AutomationProperties.Name="Running game windows"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button x:Name="RefreshGamesButton" Content="Refresh" Margin="9,0,0,0" Grid.Column="1"/></Grid>
              <WrapPanel Margin="0,12,0,0"><Button x:Name="AddGameButton" Content="Add game" Style="{StaticResource Primary}" Margin="0,0,9,0"/><Button x:Name="CaptureGameButton" Content="Capture in 5 seconds" Style="{StaticResource Quiet}"/></WrapPanel>
              <TextBlock x:Name="CaptureText" Foreground="#315CF5" FontSize="12" Margin="0,8,0,0"/>
              <Border Style="{StaticResource Rule}"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="YOUR GAMES" FontSize="10" Foreground="#9098A6" FontWeight="SemiBold" Margin="12,0,0,12"/><ListBox x:Name="EditProfiles" MinHeight="180" MaxHeight="350" AutomationProperties.Name="Profile to edit"/><Button x:Name="ImportProfilesButton" Content="Import profiles" Style="{StaticResource Quiet}" HorizontalAlignment="Left" FontSize="12"/><Button x:Name="ExportProfilesButton" Content="Export profiles" Style="{StaticResource Quiet}" HorizontalAlignment="Left" FontSize="12"/></StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock x:Name="NoProfilesText" Text="No games yet.&#x0a;&#x0a;Add a running game above, or choose one on the Focus page." Style="{StaticResource MutedText}" Margin="0,30,0,0"/>
                  <StackPanel x:Name="ProfileEditor">
                    <Grid Margin="0,0,0,18"><TextBlock Text="Profile details" FontWeight="SemiBold" FontSize="16"/><Button x:Name="DeleteProfileButton" Content="Delete" Foreground="#AE5A55" HorizontalAlignment="Right" Style="{StaticResource Quiet}" MinHeight="25" Padding="8,2" FontSize="12"/></Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,19,0"><TextBlock Text="Name" Style="{StaticResource Label}"/><TextBox x:Name="ProfileName" AutomationProperties.Name="Profile name"/><TextBlock Text="Lock area" Style="{StaticResource Label}" Margin="0,18,0,9"/><ComboBox x:Name="AreaChoice" AutomationProperties.Name="Confinement area"><ComboBoxItem Content="Game window"/><ComboBoxItem Content="Entire display"/></ComboBox><TextBlock Text="Display" Style="{StaticResource Label}" Margin="0,18,0,9"/><ComboBox x:Name="MonitorChoice" AutomationProperties.Name="Display"/></StackPanel>
                      <StackPanel Grid.Column="1"><TextBlock Text="Process" Style="{StaticResource Label}"/><TextBox x:Name="ProcessName" IsReadOnly="True" Foreground="#8B94A3" AutomationProperties.Name="Game process"/><TextBlock x:Name="InsetLabel" Text="Edge inset · 0 px" Style="{StaticResource Label}" Margin="0,18,0,9"/><Slider x:Name="InsetSlider" Minimum="0" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Edge inset in pixels"/><TextBlock Text="Distance from the window edge." Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,16"/><CheckBox x:Name="PipEnabled" Content="PiP click-through"/></StackPanel>
                    </Grid>
                    <Button x:Name="SaveProfileButton" Content="Save profile" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,22,0,0"/>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </StackPanel>

            <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,8,24,0"><TextBlock Text="Detection" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Let the app find your windows." Style="{StaticResource MutedText}" FontSize="12" Margin="0,9,0,0"/></StackPanel>
                <StackPanel Grid.Column="1"><CheckBox x:Name="AutoPipSetting" Content="Find PiP windows automatically"/><CheckBox x:Name="AutoGameSetting" Content="Recognize known games"/><TextBlock Text="Manual choices take priority. New videos are found again after a browser restart." Style="{StaticResource MutedText}" FontSize="12" Margin="0,10,0,0"/></StackPanel>
              </Grid>
              <Border Style="{StaticResource Rule}"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,5,24,0"><TextBlock Text="Keyboard" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Stay in control without leaving your game." Style="{StaticResource MutedText}" FontSize="12" Margin="0,9,0,0"/></StackPanel>
                <StackPanel Grid.Column="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,15,0"><TextBlock Text="Toggle protection" Style="{StaticResource Label}"/><ComboBox x:Name="ToggleKeyChoice" AutomationProperties.Name="Toggle protection shortcut"><ComboBoxItem Content="Ctrl + Alt + F8" Tag="F8"/><ComboBoxItem Content="Ctrl + Alt + F6" Tag="F6"/><ComboBoxItem Content="Ctrl + Alt + F10" Tag="F10"/></ComboBox></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="30-second break" Style="{StaticResource Label}"/><ComboBox x:Name="PauseKeyChoice" AutomationProperties.Name="Pause shortcut"><ComboBoxItem Content="Ctrl + Alt + F9" Tag="F9"/><ComboBoxItem Content="Ctrl + Alt + F7" Tag="F7"/><ComboBoxItem Content="Ctrl + Alt + F11" Tag="F11"/></ComboBox></StackPanel></Grid><TextBlock Text="Ctrl + Alt + F12 always releases everything." Style="{StaticResource MutedText}" FontSize="12" Margin="0,14,0,0"/><TextBlock x:Name="HotkeyStatus" Foreground="#315CF5" FontSize="12" Margin="0,8,0,0"/></StackPanel>
              </Grid>
              <Border Style="{StaticResource Rule}"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,8,24,0"><TextBlock Text="App behavior" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Tray, startup and sounds." Style="{StaticResource MutedText}" FontSize="12" Margin="0,9,0,0"/></StackPanel>
                <StackPanel Grid.Column="1"><CheckBox x:Name="TraySetting" Content="Keep running when the window closes"/><CheckBox x:Name="StartupSetting" Content="Start with Windows"/><CheckBox x:Name="MinimizedSetting" Content="Start in the system tray"/><CheckBox x:Name="SoundSetting" Content="Sound when toggling protection"/></StackPanel>
              </Grid>
              <Border Style="{StaticResource Rule}"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Local data" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0"/><StackPanel Grid.Column="1"><TextBlock x:Name="LifetimeText" Style="{StaticResource MutedText}" Margin="0,0,0,15"/><WrapPanel><Button x:Name="OpenDataButton" Content="Open data folder" Margin="0,0,10,0"/><Button x:Name="ExitButton" Content="Quit FocusFence" Style="{StaticResource Quiet}"/></WrapPanel></StackPanel></Grid>
            </StackPanel>

            <StackPanel x:Name="HelpPage" Visibility="Collapsed">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="25"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Getting started" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,25"/>
                  <TextBlock Text="01   Open your video" FontWeight="SemiBold"/><TextBlock Text="Use your browser's Picture-in-Picture mode. FocusFence looks for the floating window automatically." Style="{StaticResource MutedText}" Margin="0,9,0,25"/>
                  <TextBlock Text="02   Turn on focus mode" FontWeight="SemiBold"/><TextBlock Text="Click the power button and switch to your game. If it isn't recognized, pick it from the Game field." Style="{StaticResource MutedText}" Margin="0,9,0,25"/>
                  <TextBlock Text="03   Play as usual" FontWeight="SemiBold"/><TextBlock Text="Your cursor stays in the game. Clicks pass through the video. Alt+Tab restores the mouse and video controls." Style="{StaticResource MutedText}" Margin="0,9,0,25"/>
                </StackPanel>
                <Border Grid.Column="2" Background="#F2F5FF" CornerRadius="13" Padding="22" VerticalAlignment="Top"><StackPanel><TextBlock Text="Always a way out" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Ctrl + Alt + F12" Foreground="#315CF5" FontWeight="SemiBold" Margin="0,17,0,8"/><TextBlock Text="Turns protection off and releases your mouse and video." Style="{StaticResource MutedText}" FontSize="12"/><TextBlock Text="Ctrl + Alt + F9" Foreground="#315CF5" FontWeight="SemiBold" Margin="0,22,0,8"/><TextBlock Text="Take a 30-second break. Press it again to resume early." Style="{StaticResource MutedText}" FontSize="12"/></StackPanel></Border>
              </Grid>
              <Border Style="{StaticResource Rule}"/>
              <TextBlock Text="If something isn't detected" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Use Choose a window to pick a PiP window manually. If several videos are open, select the one you want. Windowed and borderless games work best. Some browsers and protected games can reject window changes; test your setup before an important session." Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
              <TextBlock Text="FocusFence uses Windows window functions and does not change game memory. A separate recovery companion attempts to restore its changes if the app exits unexpectedly." Style="{StaticResource MutedText}" FontSize="12" Margin="0,16,0,0"/>
            </StackPanel>
          </Grid></ScrollViewer>
          <Border Grid.Row="2" BorderBrush="#EAECF1" BorderThickness="0,1,0,0"><Grid><TextBlock x:Name="FooterStatus" Text="Protection off · Mouse released" Foreground="#929AA9" FontSize="10" VerticalAlignment="Center" Margin="0,0,205,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="Emergency release" FontSize="10" Foreground="#929AA9" Margin="0,0,9,0" VerticalAlignment="Center"/><Border Style="{StaticResource Keycap}" Padding="6,3"><TextBlock Text="Ctrl + Alt + F12" FontSize="10" Foreground="#68748B"/></Border></StackPanel><TextBlock x:Name="FooterTime" Visibility="Collapsed"/></Grid></Border>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="#606A79" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource Quiet}">
